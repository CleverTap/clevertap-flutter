{
  "name": "CleverTap Flutter SDK Update Automation",
  "version": "1.0.0",
  "description": "Automates version updates for Flutter SDK",
  "tasks": {
    "update-version": {
      "description": "Update Flutter SDK, Android SDK versions and changelog",
      "file": "claude_tasks/update_version.md",
      "parameters": {
        "flutter_version": {
          "type": "string",
          "required": true,
          "description": "New Flutter SDK version"
        },
        "android_sdk_version": {
          "type": "string",
          "required": true,
          "description": "New Android SDK version"
        },
        "changelog_text": {
          "type": "string",
          "required": true,
          "description": "Changelog entry text"
        },
        "release_date": {
          "type": "string",
          "required": true,
          "description": "Release date (DD Month YYYY)"
        }
      }
    }
  }
}
